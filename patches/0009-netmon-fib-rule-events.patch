diff --git a/net/netmon/netmon_rules_linux_test.go b/net/netmon/netmon_rules_linux_test.go
new file mode 100644
index 0000000..fe2a5ea
--- /dev/null
+++ b/net/netmon/netmon_rules_linux_test.go
@@ -0,0 +1,64 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build linux && !android
+
+package netmon
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/mdlayher/netlink"
+	"golang.org/x/sys/unix"
+)
+
+func ruleMsg(t *testing.T, family, hdrTable uint8, attrs ...netlink.Attribute) []byte {
+	t.Helper()
+	hdr := make([]byte, 12) // struct fib_rule_hdr
+	hdr[0], hdr[4] = family, hdrTable
+	b, err := netlink.MarshalAttributes(attrs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return append(hdr, b...)
+}
+
+func u32(v uint32) []byte {
+	return binary.NativeEndian.AppendUint32(nil, v)
+}
+
+func TestParseDeletedRule(t *testing.T) {
+	for _, family := range []uint8{unix.AF_INET, unix.AF_INET6} {
+		// A netd rule: uid range (8 bytes, attribute 20), and a per-network
+		// table too large for the header, which then holds RT_TABLE_COMPAT.
+		msg := ruleMsg(t, family, unix.RT_TABLE_COMPAT,
+			netlink.Attribute{Type: unix.FRA_UID_RANGE, Data: append(u32(10000), u32(19999)...)},
+			netlink.Attribute{Type: unix.FRA_PRIORITY, Data: u32(13000)},
+			netlink.Attribute{Type: unix.FRA_TABLE, Data: u32(1017)},
+		)
+		got, err := parseDeletedRule(msg)
+		if want := (RuleDeleted{Table: 1017, Priority: 13000}); err != nil || got != want {
+			t.Errorf("family %d: got %+v, %v; want %+v", family, got, err, want)
+		}
+	}
+
+	// Priority 0 has no attribute, and a small table may be header-only.
+	if got, err := parseDeletedRule(ruleMsg(t, unix.AF_INET, 52)); err != nil || got != (RuleDeleted{Table: 52}) {
+		t.Errorf("header-only rule: got %+v, %v", got, err)
+	}
+
+	if _, err := parseDeletedRule(make([]byte, 11)); err == nil {
+		t.Error("accepted a short header")
+	}
+	bad := ruleMsg(t, unix.AF_INET, 52, netlink.Attribute{Type: unix.FRA_PRIORITY, Data: []byte{1}})
+	if _, err := parseDeletedRule(bad); err == nil {
+		t.Error("accepted a 1-byte priority")
+	}
+}
+
+func TestNetlinkGroupsIncludeIPv6Rules(t *testing.T) {
+	if netlinkGroups&(1<<(unix.RTNLGRP_IPV6_RULE-1)) == 0 {
+		t.Error("IPv6 rule group missing")
+	}
+}
