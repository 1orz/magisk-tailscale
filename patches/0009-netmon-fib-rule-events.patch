diff --git a/net/netmon/netmon_linux.go b/net/netmon/netmon_linux.go
index b7d87f9..b31b001 100644
--- a/net/netmon/netmon_linux.go
+++ b/net/netmon/netmon_linux.go
@@ -6,6 +6,7 @@
 package netmon
 
 import (
+	"fmt"
 	"net"
 	"net/netip"
 	"time"
@@ -32,7 +33,7 @@ func (unspecifiedMessage) ignore() bool { return false }
 // was deleted.
 type RuleDeleted struct {
 	// Table is the table number that the deleted rule referenced.
-	Table uint8
+	Table uint32
 	// Priority is the lookup priority of the deleted rule.
 	Priority uint32
 }
@@ -56,15 +57,49 @@ type nlConn struct {
 	addrCache map[uint32]map[netip.Addr]bool
 }
 
+// magisk-tailscale-next: rule events are fib_rule_hdr messages with FRA_*
+// attributes, not routes. Android's netd deletes rules carrying an 8-byte
+// FRA_UID_RANGE, attribute 20, which the route parser takes for the 1-byte
+// RTA_PREF and rejects; its per-network tables also exceed the header's
+// one-byte table field. IPv6 rule events need their own group, which
+// x/sys/unix has no RTMGRP_* constant for.
+const netlinkGroups = unix.RTMGRP_IPV4_IFADDR | unix.RTMGRP_IPV6_IFADDR |
+	unix.RTMGRP_IPV4_ROUTE | unix.RTMGRP_IPV6_ROUTE |
+	unix.RTMGRP_IPV4_RULE | 1<<(unix.RTNLGRP_IPV6_RULE-1)
+
+// parseDeletedRule decodes the table and priority of an RTM_DELRULE
+// message, ignoring the other attributes.
+func parseDeletedRule(data []byte) (RuleDeleted, error) {
+	const fibRuleHdrLen = 12
+	if len(data) < fibRuleHdrLen {
+		return RuleDeleted{}, fmt.Errorf("short fib_rule_hdr: %d bytes", len(data))
+	}
+	rd := RuleDeleted{Table: uint32(data[4])}
+	ad, err := netlink.NewAttributeDecoder(data[fibRuleHdrLen:])
+	if err != nil {
+		return RuleDeleted{}, err
+	}
+	for ad.Next() {
+		switch ad.Type() {
+		case unix.FRA_PRIORITY:
+			rd.Priority = ad.Uint32()
+		case unix.FRA_TABLE:
+			rd.Table = ad.Uint32()
+		}
+	}
+	if err := ad.Err(); err != nil {
+		return RuleDeleted{}, err
+	}
+	return rd, nil
+}
+
