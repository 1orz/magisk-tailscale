+	androidAdvertising bool // whether subnet routes (or exit node) are advertised
+	androidFwdTable4   int  // table of the installed IPv4 forwarding rule, or 0
+	androidFwdTable6   int  // table of the installed IPv6 forwarding rule, or 0
+	androidIPFwd       bool // whether IP forwarding was requested from netd
+	androidFwdTimer    *time.Timer
 }
 
 func newUserspaceRouter(logf logger.Logf, tunDev tun.Device, netMon *netmon.Monitor, health *health.Tracker, bus *eventbus.Bus) (router.Router, error) {
@@ -145,6 +152,10 @@ func newUserspaceRouterAdvanced(logf logger.Logf, tunname string, netMon *netmon
 	r.rulesAddedPub = eventbus.Publish[AddIPRules](ec)
 	eventbus.SubscribeFunc(ec, func(rs netmon.RuleDeleted) {
 		r.onIPRuleDeleted(rs.Table, rs.Priority)
+		if getDistroFunc() == distro.Android {
+			// netd swaps its rules when the default network changes.
+			r.scheduleAndroidForwardingUpdate()
+		}
 	})
 	eventbus.SubscribeFunc(ec, func(pu router.PortUpdate) {
 		r.logf("portUpdate(port=%v, network=%s)", pu.UDPPort, pu.EndpointNetwork)
@@ -197,8 +208,11 @@ func newUserspaceRouterAdvanced(logf logger.Logf, tunname string, netMon *netmon
 	// netd's legacy_system rule (10000) and before its per-app VPN and
 	// network rules (11000+).
 	if getDistroFunc() == distro.Android {
-		r.ipPolicyPrefBase = 10500
-		r.logf("Android detected, switching policy base priority to 10500")
+		r.ipPolicyPrefBase = androidIPPolicyPrefBase
+		r.logf("Android detected, switching policy base priority to %d", androidIPPolicyPrefBase)
+		eventbus.SubscribeFunc(ec, func(netmon.ChangeDelta) {
+			r.scheduleAndroidForwardingUpdate()
+		})
 	}
 
 	r.fixupWSLMTU()
@@ -404,6 +418,14 @@ func (r *linuxRouter) Close() error {
 	}
 	r.eventClient.Close()
 
+	if getDistroFunc() == distro.Android {
+		if r.androidFwdTimer != nil {
+			r.androidFwdTimer.Stop()
+		}
+		r.androidAdvertising = false
+		r.updateAndroidForwardingLocked()
+	}
+
 	// Clean up connmark rules
 	if err := r.nfr.DelConnmarkSaveRule(); err != nil {
 		r.logf("warning: failed to delete connmark rules: %v", err)
@@ -603,6 +625,10 @@ func (r *linuxRouter) Set(cfg *router.Config) error {
 	if getDistroFunc() == distro.Gokrazy && advertisingRoutes {
 		r.enableIPForwarding()
 	}
+	if getDistroFunc() == distro.Android {
+		r.androidAdvertising = advertisingRoutes
+		r.updateAndroidForwardingLocked()
+	}
 
 	// Remove the rule to drop off-tailnet CGNAT traffic, if needed.
 	if netfilterOn || r.netfilterMode == netfilterNoDivert {
@@ -1978,6 +2004,9 @@ func cleanUp(logf logger.Logf, interfaceName string) {
 		linuxfw.IPTablesCleanUp(logf)
 		linuxfw.NfTablesCleanUp(logf)
 	}
+	if getDistroFunc() == distro.Android {
+		cleanUpAndroidForwarding(logf)
+	}
 	removeOrphanedAddrsForCleanup(logf, osCommandRunner{ambientCapNetAdmin: useAmbientCaps()}, interfaceName)
 }
 
