@@ -0,0 +1,27 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build !android
+
+package osrouter
+
+import (
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+func TestAndroidForwardRule(t *testing.T) {
+	r := &linuxRouter{ipPolicyPrefBase: androidIPPolicyPrefBase, tunname: "tailscale0"}
+	ru := r.androidForwardRule(netlink.FAMILY_V4, 1012)
+	if ru.IifName != "tailscale0" || ru.Table != 1012 || ru.Family != netlink.FAMILY_V4 {
+		t.Errorf("got %+v, want iif tailscale0 lookup 1012", ru)
+	}
+	// After the Tailscale table rule (so a device using an exit node routes
+	// through it), before netd's per-app rules at 11000, and inside the
+	// range onIPRuleDeleted watches.
+	main := androidIPPolicyPrefBase + androidIPRules[0].Priority
+	if ru.Priority <= main || ru.Priority >= 11000 || ru.Priority >= r.ipPolicyPrefBase+100 {
+		t.Errorf("forwarding rule priority %d not in (%d, 11000)", ru.Priority, main)
+	}
+}
